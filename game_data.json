    "commute_direct": {
      "title": "路上 07:00",
      "text": "你拿着包子边走边啃，来到地铁站口。看着排队的人群，你决定换个方式。",
      "choices": [
        {
          "text": "坐地铁",
          "next": "subway",
          "effects": {}
        },
        {
          "text": "骑共享单车",
          "next": "bike",
          "effects": {}
