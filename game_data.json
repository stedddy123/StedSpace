{
  "meta": {
    "title": "牛马打工日常",
    "subtitle": "被困在周五的无限循环",
    "description": "不知从哪天起，你被困在了周五这一天。周一到周四的记忆一片空白，每个周五都在重演同样的牛马日常。据说只有打出传说中1%概率的完美结局，才能跳出这个循环，迎来真正的周末。",
    "stats_init": {
      "打工魂": 50,
      "摸鱼值": 0,
      "牛马指数": 0,
      "精神值": 30
    },
    "stat_descriptions": {
      "打工魂": "你对工作的热爱与执着，太高会被压榨，太低会摆烂",
      "摸鱼值": "你在工作中摸鱼的程度，适度摸鱼有益身心",
      "牛马指数": "你被当作牛马使唤的程度，越高越惨",
      "精神值": "精神承受度：循环越久越受压，突破100将彻底崩溃"
    },
    "loop_setting": {
      "enabled": true,
      "desc": "你被困在周五的循环里。每进入一轮循环，精神值就会上升，靠各种选择可以缓解。精神值爆表将陷入无尽循环；只有1%概率的完美结局能真正跳出循环。"
    }
  },
  "random_events": {
    "ev_rain": {
      "title": "突发 · 暴雨",
      "text": "刚走出门，天空突然乌云密布，豆大的雨点劈头盖脸砸下来。你没带伞，瞬间变成落汤鸡。",
      "choices": [
        {
          "text": "冒雨狂奔，管他呢",
          "next": "RETURN",
          "effects": {
            "牛马指数": 5,
            "打工魂": -3,
            "精神值": 5
          }
        },
        {
          "text": "花15块买把透明伞",
          "next": "RETURN",
          "effects": {
            "打工魂": 2
          }
        }
      ]
    },
    "ev_bike_broken": {
      "name": "共享单车罢工",
      "text": "你扫了一辆共享单车，刚骑出100米，链条突然咔哒一声断了。你推着车在路边凌乱，旁边的大爷投来同情的目光。",
      "choices": [
        {
          "text": "换一辆继续骑",
          "next": "RETURN",
          "effects": {
            "打工魂": 2,
            "精神值": 5
          }
        },
        {
          "text": "直接走路去公司",
          "next": "RETURN",
          "effects": {
            "摸鱼值": 3
          }
        }
      ]
    },
    "ev_lift_fail": {
      "name": "电梯故障",
      "text": "写字楼的电梯今天检修，两台电梯停了一台，队伍排到了大厅门口。看着人群，你估算了一下：等电梯至少15分钟。",
      "choices": [
        {
          "text": "爬楼梯！15楼而已",
          "next": "RETURN",
          "effects": {
            "打工魂": 8,
            "精神值": -5
          }
        },
        {
          "text": "慢慢排队等电梯",
          "next": "RETURN",
          "effects": {
            "摸鱼值": 3,
            "牛马指数": 5,
            "精神值": 8
          }
        }
      ]
    },
    "ev_blue_screen": {
      "name": "电脑蓝屏",
      "text": "你刚打开电脑准备干活，屏幕上突然出现一片忧郁的蓝色，上面写着一行英文错误码。你辛辛苦苦改了一半的代码，估计是没了。",
      "choices": [
        {
          "text": "重启硬扛，假装无事发生",
          "next": "RETURN",
          "effects": {
            "牛马指数": 5,
            "精神值": 5
          }
        },
        {
          "text": "找IT大哥帮忙恢复",
          "next": "RETURN",
          "effects": {
            "打工魂": 3,
            "摸鱼值": 5
          }
        }
      ]
    },
    "ev_meeting": {
      "name": "临时加会",
      "text": "刚坐下还没喝口水的你被拉进了会议室：临时加会！组长在台上讲得激情澎湃，你在台下听得昏昏欲睡。",
      "choices": [
        {
          "text": "假装认真记笔记，其实在发呆",
          "next": "RETURN",
          "effects": {
            "摸鱼值": 5
          }
        },
        {
          "text": "趁机提问，展示存在感",
          "next": "RETURN",
          "effects": {
            "打工魂": 5,
            "牛马指数": 5,
            "精神值": 5
          }
        }
      ]
    },
    "ev_wrong_lunch": {
      "name": "外卖送错",
      "text": "中午点的外卖终于到了，你满怀期待地打开——里面是一份凉皮，而你可能点的是螺蛳粉。外卖小哥一脸无辜：路上太忙了，拿错了。",
      "choices": [
        {
          "text": "凑合吃了吧，别折腾了",
          "next": "RETURN",
          "effects": {
            "牛马指数": 3,
            "精神值": 5
          }
        },
        {
          "text": "要求退款重送",
          "next": "RETURN",
          "effects": {
            "摸鱼值": 5,
            "精神值": -3
          }
        }
      ]
    },
    "ev_code_fail": {
      "name": "代码崩了",
      "text": "下午3点，你提交的代码在测试环境崩了，报错日志刷了满屏。测试小姐姐拿着手机走过来：这是你写的吧？",
      "choices": [
        {
          "text": "赶紧道歉修Bug",
          "next": "RETURN",
          "effects": {
            "牛马指数": 5,
            "打工魂": 5,
            "精神值": 8
          }
        },
        {
          "text": "甩锅给网络波动",
          "next": "RETURN",
          "effects": {
            "摸鱼值": 8,
            "精神值": -5
          }
        }
      ]
    },
    "ev_customer_rage": {
      "name": "客户发飙",
      "text": "客户突然在群里@你：这个功能到底什么时候上线？！后面跟了三个感叹号。群里瞬间安静，领导也默默潜水了。",
      "choices": [
        {
          "text": "安抚客户，承诺时间",
          "next": "RETURN",
          "effects": {
            "牛马指数": 5,
            "精神值": 5
          }
        },
        {
          "text": "假装没看到，等下班",
          "next": "RETURN",
          "effects": {
            "摸鱼值": 5,
            "精神值": -5
          }
        }
      ]
    },
    "ev_boss_good": {
      "name": "老板心情好",
      "text": "下班前，老板竟然主动走过来，拍了拍你的肩膀：今天表现不错，辛苦了！他今天居然在笑，这在公司历史上都罕见。",
      "choices": [
        {
          "text": "趁机提加薪的请求",
          "next": "RETURN",
          "effects": {
            "打工魂": 5,
            "精神值": 5
          }
        },
        {
          "text": "谢过老板，赶紧下班",
          "next": "RETURN",
          "effects": {
            "摸鱼值": 3
          }
        }
      ]
    }
  },
  "endings": {
    "ending_overtime": {
      "title": "加班到深夜",
      "text": "晚上9点，你终于提交了所有代码。走出公司大门，街灯已经亮了。外卖小哥跟你擦肩而过——他看起来比你精神。你抬头看看月亮，又一次循环开始了……",
      "type": "ending"
    },
    "ending_leave": {
      "title": "准时下班",
      "text": "6:00准时关电脑走人。身后传来领导的目光，但你已走进电梯。晚风拂面，你感到久违的自由。不过明天醒来，你大概会发现自己又回到了周五早上……",
      "type": "ending"
    },
    "ending_breakdown": {
      "title": "心态崩了",
      "text": "你盯着屏幕上的报错，突然觉得这一切毫无意义。你站起来，把工牌摘下放在桌上，大步走出公司。但走出大门的那一刻，你眼前一花——又回到了周五的清晨。",
      "type": "ending"
    },
    "ending_perfect": {
      "title": "完美周末",
      "text": "就在你按下提交键的那一刻，整个办公室的空气突然凝固了。屏幕上的Bug列表瞬间清空，代码全部通过测试。老板罕见地走过来，递给你一张卡片：'这个项目干得漂亮，这个周五，提前下班，周末加双倍调休！'\n你愣在原地。窗外，晚霞铺满天空，你走出公司大门，没有眩晕，没有循环。你自由了！\n恭喜你，你打出了传说中1%的完美结局，成功跳出了周五的无限循环。",
      "type": "perfect",
      "special": true
    },
    "ending_breakdown_loop": {
      "title": "无尽循环",
      "text": "你的精神值终于突破了极限。眼前的办公室开始扭曲变形，同事们的脸变成一帧帧重复的画面，连老板那句'这个功能今天能出吗'都开始自动循环播放。\n你忽然明白：你不是被困在周五里，你就是周五本身。这一次，不会有下一轮了。\n游戏结束。",
      "type": "ending",
      "game_over": true
    }
  },
  "ending_eval": {
    "rules": [
      {
        "condition": {
          "stat": "精神值",
          "op": ">=",
          "value": 100
        },
        "ending": "ending_breakdown_loop",
        "comment": "精神值突破了底线，你彻底迷失在循环之中"
      },
      {
        "condition": {
          "stat": "牛马指数",
          "op": ">=",
          "value": 25
        },
        "ending": "ending_overtime",
        "comment": "你是当之无愧的牛马之王，加班到深夜"
      },
      {
        "condition": {
          "stat": "打工魂",
          "op": "<=",
          "value": 20
        },
        "ending": "ending_breakdown",
        "comment": "打工魂已经熄灭，你选择了不再忍了"
      },
      {
        "condition": {
          "default": true
        },
        "ending": "ending_leave",
        "comment": "你活到了下班，虽然还在循环里，但至少今天下班了"
      }
    ]
  },
  "nodes": {
    "start": {
      "title": "清晨 06:30",
      "text": "闹钟响了。你睁开眼，看着天花板，总觉得自己做了个很长的梦，梦里还是周五。不管了，又是牛马的一天。挣扎着爬起来吧。",
      "choices": [
        {
          "text": "再睡5分钟……就5分钟",
          "next": "snooze",
          "effects": {
            "摸鱼值": 5
          }
        },
        {
          "text": "立刻起床，燃烧打工魂",
          "next": "getup",
          "effects": {
            "打工魂": 5
          }
        }
      ]
    },
    "snooze": {
      "title": "清晨 07:00",
      "text": "再睁眼已经7:00了！你一个猛子扎起来，刷牙洗脸三分钟搞定。头发还是乱的，但管不了那么多了，冲！",
      "choices": [
        {
          "text": "打车！花钱买准时",
          "next": "taxi_late",
          "effects": {
            "打工魂": -5,
            "精神值": -3
          }
        },
        {
          "text": "挤地铁，牛马专列",
          "next": "subway_rush",
          "effects": {
            "牛马指数": 5,
            "精神值": 8
          }
        }
      ]
    },
    "getup": {
      "title": "清晨 06:35",
      "text": "你从容地起床、洗漱，还煮了碗面当早餐。6:55出门，阳光正好，你觉得今天运气不错。",
      "choices": [
        {
          "text": "在家慢慢吃完早餐再走",
          "next": "breakfast",
          "effects": {
            "打工魂": 3
