        {
          "text": "有点慌，下午主动汇报下",
          "next": "boss_stroll",
          "effects": {
            "打工魂": 5,
            "牛马指数": 5
          }
        }
      ]
    },
    "boss_stroll": {
      "title": "上午 10:00",
      "text": "上午10点，你正对着屏幕，余光瞥见老板端着一杯茶从办公室溜达出来了，脚步不停，目光扫过每一个工位。",
      "event_pool": [
        "ev_blue_screen",
        "ev_meeting"
