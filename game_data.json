      "event_chance": 0.3,
      "choices": [
        {
          "text": "立刻正襟危坐，假装在工作",
          "next": "work",
          "effects": {
            "打工魂": 3,
            "精神值": 5
          }
        },
        {
          "text": "趁机站起来去找同事讨论",
          "next": "slack_work",
          "effects": {
            "摸鱼值": 5,
            "精神值": -5
          }
