    },
    "breakfast": {
      "title": "早餐 06:45",
      "text": "你慢悠悠地吃了碗热腾腾的面条，喝了口豆浆，感觉元气满满。出门时正好赶上地铁不挤的时段。",
      "choices": [
        {
          "text": "坐地铁，稳稳当当",
          "next": "subway",
          "effects": {
            "打工魂": 5
          }
        },
        {
          "text": "骑共享单车，吹吹风",
          "next": "bike",
          "effects": {
            "打工魂": 3
          }
        }
